# Copy to .env and fill in real values. Never commit .env (see .gitignore).

PORT=3001

# Vbee TTS (https://vbee.vn/api-docs) — get these from your Vbee dashboard.
VBEE_APP_ID=
VBEE_TOKEN=
# Never resolves per RFC 2606; Vbee accepts it and this app has no public endpoint to receive it.
VBEE_WEBHOOK_URL=https://vbee-callback.invalid/noop

# Dedicated Chrome profile dir used for Google Flow automation via Playwright CDP.
CHROME_USER_DATA_DIR=./chrome-profile
