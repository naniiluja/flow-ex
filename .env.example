# Copy to .env and fill in real values. Never commit .env (see .gitignore).

PORT=3001

# Vbee TTS (https://vbee.vn/api-docs) — get these from your Vbee dashboard.
VBEE_APP_ID=
VBEE_TOKEN=
# Never resolves per RFC 2606; Vbee accepts it and this app has no public endpoint to receive it.
VBEE_WEBHOOK_URL=https://vbee-callback.invalid/noop

# Dedicated Chrome profile dir used for Google Flow automation via Playwright CDP. NEVER point
# this at your default Chrome profile (see be/.claude/rules/flow-automation.md); the first real
# run against a fresh directory here needs a one-time manual Google sign-in in the opened window.
CHROME_USER_DATA_DIR=./chrome-profile
CHROME_CDP_PORT=9222
# Only needed on Linux/Windows or a non-standard install; defaults to the standard macOS
# Google Chrome.app path.
CHROME_EXECUTABLE_PATH=

# "real" drives actual Google Flow (task 005); "fake" (default) writes synthetic images with no
# Chrome/network involved, which is what local dev and the test suite use.
FLOW_IMAGE_PROVIDER=fake

# "whisper" transcribes real audio with whisper.cpp (task 007, installs a real multilingual
# model on first use); "fake" (default) fabricates captions with no download/network involved,
# which is what local dev and the test suite use.
TRANSCRIBE_PROVIDER=fake
WHISPER_MODEL=small
WHISPER_CPP_VERSION=1.5.5
WHISPER_CACHE_DIR=./.whisper-cache
